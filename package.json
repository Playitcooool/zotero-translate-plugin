{
  "name": "zotero-translate-plugin",
  "version": "0.1.1",
  "description": "一款轻量的 Zotero 7 PDF 划词翻译插件，支持自定义快捷键，兼容本地 Ollama 模型以及 OpenAI Compatible / LLM、DeepL、LibreTranslate 等翻译服务。",
  "author": "Playitcooool",
  "homepage": "https://github.com/Playitcooool/zotero-translate-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Playitcooool/zotero-translate-plugin.git"
  },
  "config": {
    "addonName": "Zotero Translate",
    "addonID": "zoterotranslate@plugin.local",
    "addonRef": "zoterotranslate",
    "prefsPrefix": "extensions.zotero.zoterotranslate",
    "addonInstance": "ZoteroTranslate"
  },
  "scripts": {
    "build": "zotero-plugin build",
    "watch": "zotero-plugin serve",
    "start": "zotero-plugin serve"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.3"
  }
}
